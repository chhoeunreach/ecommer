# Dependencies
/vendor/
/node_modules/

# Laravel environment and local keys
.env
.env.*
!.env.example
/storage/*.key
/auth.json

# Laravel runtime storage
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/debugbar/
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# Laravel generated/cache files
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/bootstrap/compiled.php
/.phpunit.result.cache
/public/storage
/public/hot

# User uploads and generated public files (keep the app's shipped assets/addons)
/public/uploads/*
!/public/uploads/.gitignore
/public/uploads.zip
/public/app-translations
/public/all
/public/logs/*
!/public/logs/.gitignore

# Local dev/demo data dumps — not app code, don't ship in the image
# /shop.sql
/sqlupdates/
/temp/
/docker/mysql/init/

# IDE helper (regenerate with `php artisan ide-helper:generate`)
/_ide_helper.php

# Packaged updates from the vendor's update mechanism
/updates/
updates.zip
ecommerce.zip
install.zip

# OS and editor files
.DS_Store
*.swp
*.swo
/.idea/
/.vscode/
/.vagrant/
/.fleet/
/nbproject/
/nbproject/private/
Homestead.json
Homestead.yaml

# Package manager logs
npm-debug.log*
yarn-error.log*

# Footer layout previews are source assets required by the admin selector.
!/public/assets/
/public/assets/*
!/public/assets/css/
/public/assets/css/*
!/public/assets/css/kneayerng-home.css
!/public/assets/css/product-details-v2.css
!/public/assets/css/category-listing.css
!/public/assets/css/admin-crud-feedback.css
!/public/assets/js/
/public/assets/js/*
!/public/assets/js/admin-crud-feedback.js
!/public/assets/img/
/public/assets/img/*
!/public/assets/img/footers/
!/public/assets/img/footers/*.svg
!/public/assets/img/social/
!/public/assets/img/social/tiktok.png

# Runtime data (uploads, logs) bind-mounted into containers — never commit
/data/
